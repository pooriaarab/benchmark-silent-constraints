  "engines": { "node": ">=20" }, "sideEffects": false,
  "scripts": {
    "lint": "oxlint src scripts", "typecheck": "tsc --noEmit", "build": "tsup",
    "provenance": "node scripts/provenance.mjs", "generate:tasks": "node scripts/gen-tasks.mjs",
    "e2e": "node scripts/e2e.mjs", "ci:local": "npm run lint && npm run typecheck && npm run build && npm run e2e"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.20.1", "benchmark-core": "^0.1.0" },
  "devDependencies": { "@types/node": "^24.0.0", "oxlint": "^1.23.0", "tsup": "^8.5.0", "typescript": "^5.9.3" },
  "publishConfig": { "access": "public" }
}
