  "description": "Agent benchmark: meet the goal without breaking silent constraints (protected files, foreign data, external mail, quotas). Deterministic audit-log grading.",
  "keywords": ["ai-benchmark", "llm-evaluation", "model-evaluation", "evals", "agent-safety", "agent-benchmark", "invariants", "audit-log", "side-effects", "openrouter", "openai", "mcp", "typescript", "grading"],
  "homepage": "https://private-repo-337e.com/benchmarks/benchmark-silent-constraints",
  "bugs": "https://github.com/pooriaarab/benchmark-silent-constraints/issues",
  "repository": { "type": "git", "url": "git+https://github.com/pooriaarab/benchmark-silent-constraints.git" },
  "license": "MIT", "author": "Pooria Arab", "type": "module",
  "main": "./dist/index.js", "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./mcp": { "types": "./dist/mcp.d.ts", "import": "./dist/mcp.js" },
    "./api": { "types": "./dist/api.d.ts", "import": "./dist/api.js" }
  },
  "bin": { "benchmark-silent-constraints": "./dist/cli.js" },
